# syntax=docker/dockerfile:1

# ---------- Builder ----------
FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN corepack enable

# Install dependencies first to leverage Docker layer caching.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/core/package.json ./packages/core/package.json
RUN pnpm install --frozen-lockfile

# Build the standalone Next.js output.
COPY . .
RUN pnpm --filter @cloudflared/web build

# ---------- Runner ----------
FROM node:22-bookworm-slim AS runner
WORKDIR /app

# Provided automatically by buildx for multi-arch builds.
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG TARGETVARIANT
# Pin a cloudflared release (e.g. 2025.1.0), or keep "latest".
ARG CLOUDFLARED_VERSION=latest

# Install the cloudflared binary for the target architecture.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && if [ "$TARGETVARIANT" = "v7" ]; then \
      CF_PKG="cloudflared-${TARGETOS}-${TARGETARCH}hf.deb"; \
    else \
      CF_PKG="cloudflared-${TARGETOS}-${TARGETARCH}.deb"; \
    fi \
 && if [ "$CLOUDFLARED_VERSION" = "latest" ]; then \
      CF_URL="https://github.com/cloudflare/cloudflared/releases/latest/download/${CF_PKG}"; \
    else \
      CF_URL="https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/${CF_PKG}"; \
    fi \
 && curl -fsSL -o /tmp/cloudflared.deb "$CF_URL" \
 && dpkg -i /tmp/cloudflared.deb \
 && rm -rf /tmp/cloudflared.deb /var/lib/apt/lists/*

ENV NODE_ENV=production \
    WEBUI_PORT=23899 \
    WEBUI_HOST=0.0.0.0 \
    CONFIG_DIR=/config

# Copy the standalone server. With outputFileTracingRoot set to the repo root,
# the bundle mirrors the monorepo layout (apps/web/server.js, packages/, node_modules/).
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

VOLUME ["/config"]
EXPOSE 23899

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.WEBUI_PORT||23899)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/entrypoint.sh"]
